# Local development settings for apps/api (copy to apps/api/.env). Production: deploy/linux/env/api.env.example.
ENV=dev
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://nexfox:password@127.0.0.1:5432/nexfox   # PostgreSQL is the production database
APP_SECRET=change-me-to-a-long-random-string-64-chars
EA_SIGNING_SECRET=change-me-too-and-bake-the-same-value-into-the-EA-build
MT5_CREDENTIALS_KEY=                      # python -m app.cli gen-key  (required in production)
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

BILLING_PROVIDER=mock                     # mock (dev only) | manual | stripe
TRIAL_DAYS=7
ALLOW_LIVE_TRADING=false
AUTO_MIGRATE=true
RUN_SCHEDULER_IN_API=true
DEV_SHOW_EMAIL_CODES=true                 # dev: verification/reset codes are printed in the API log
LOG_JSON=false
