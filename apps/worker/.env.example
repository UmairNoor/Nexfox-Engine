# apps/worker/.env — NexFox Engine MT5 worker (Windows host). Never commit a filled copy.
NEXFOX_API_URL=https://app.example.com
# From Admin console -> Workers -> Register worker (shown once)
WORKER_TOKEN=
WORKER_NAME=win-vps-01

# One MetaTrader 5 installation per slot, separated by ';'. Each account always uses the same terminal.
# Install MT5 into separate folders (e.g. C:\MT5\slot1, C:\MT5\slot2) and start each once so it is initialised.
MT5_TERMINALS=C:\MT5\slot1\terminal64.exe;C:\MT5\slot2\terminal64.exe
MT5_BACKEND=real

# Where the worker keeps per-instance state (level tracker, order-result journal, terminal assignments)
WORKER_DATA_DIR=C:\NexFox\worker-data
SYNC_INTERVAL=5
HEARTBEAT_INTERVAL=5
LOG_JSON=true
LOG_LEVEL=INFO
# Shown in every log line (default prod)
ENV=prod
# Optional: where the bot strategy folders live (default: <repo>\bots)
# BOTS_DIR=C:\NexFox\src\bots

# Development / tests only - never on a host that trades:
#   MT5_BACKEND=fake, FAKE_MT5_CONFIG=<json file with simulated accounts>, FAKE_SLOTS=2, WORKER_FAST=true
