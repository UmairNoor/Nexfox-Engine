# /opt/nexfox/shared/api.env — production API + scheduler settings. install.sh fills the __PLACEHOLDERS__ once.
# File mode 640 root:nexfox. Never commit a filled copy.
ENV=prod
LOG_JSON=true
LOG_LEVEL=INFO

# PostgreSQL. After running infra/sql/010_rls.sql, switch to the RLS-restricted role:
#   DATABASE_URL=postgresql+psycopg://nexfox_app:<APP_DB_PASSWORD from db-owner.env>@127.0.0.1:5432/nexfox
DATABASE_URL=__DATABASE_URL__
REDIS_URL=redis://127.0.0.1:6379/0

APP_SECRET=__APP_SECRET__
EA_SIGNING_SECRET=__EA_SECRET__
MT5_CREDENTIALS_KEY=__CRED_KEY__

WEB_URL=https://__DOMAIN__
CORS_ORIGINS=https://__DOMAIN__

# Migrations run from deploy.sh (as the DB owner); the scheduler runs as its own service.
AUTO_MIGRATE=false
RUN_SCHEDULER_IN_API=false

# Billing: manual (admins grant plans) until Stripe credentials exist. Never "mock" in production.
BILLING_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
TRIAL_DAYS=7
TRIAL_ENABLED=true
ENTITLEMENT_LAPSE_POLICY=block_new_entries

# Trading safety. Live trading stays OFF until a demo verification period is complete and you decide otherwise.
ALLOW_LIVE_TRADING=false
MAX_LOT_HARD=1.0
MAX_ORDERS_PER_INSTANCE_DAY=50
WORKER_LEASE_SECONDS=45

# Email (verification + password reset codes). Without SMTP, users cannot verify or reset passwords.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NexFox Engine <no-reply@__DOMAIN__>
DEV_SHOW_EMAIL_CODES=false

# SMTP_STARTTLS=true

# Telegram alerts (optional). Uncomment and set your own bot's @username from BotFather; while it is unset the
# dashboard's "link Telegram" button answers "not configured".
# TELEGRAM_BOT_USERNAME=YourBotName
TELEGRAM_BOT_TOKEN=
TELEGRAM_CALLBACK_SECRET=

EA_DOWNLOAD_DIR=/opt/nexfox/shared/downloads

# ---- Optional tuning (defaults shown) ----
# APP_NAME=NexFox Engine API
# SERVICE_NAME=api
# DB_POOL_SIZE=10
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30
# HANDSHAKE_TTL_SECONDS=600
# LICENSE_GRACE_HOURS=72
# OFFLINE_TRADE_BLOCK_HOURS=24
# INSTANCE_HEARTBEAT_TIMEOUT_SECONDS=90
# RATE_LIMIT_AUTH_PER_MIN=20
# RATE_LIMIT_GATEWAY_PER_MIN=240
# RETENTION_HEARTBEATS_DAYS=14
# RETENTION_BOT_EVENTS_DAYS=90
# RETENTION_AI_TASKS_DAYS=180
# RETENTION_NOTIFICATIONS_DAYS=90
